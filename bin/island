#!/usr/bin/env node
// ABOUTME: Command line client for the island: list plugins, read state, trigger actions, push live activities.
// ABOUTME: Run with no arguments for usage. Talks to GNOME Shell through gdbus.
import {callIsland} from '../src/cli/bus-client.js';
import {parseCommand, parseGdbusString, parseGdbusStringArray} from '../src/cli/command.js';

try {
    const {method, args} = parseCommand(process.argv.slice(2));
    const output = callIsland(method, args);

    if (method === 'ListPlugins')
        console.log(parseGdbusStringArray(output).join('\n'));
    else if (method === 'GetForeground')
        console.log(parseGdbusString(output));
    else if (method === 'GetState')
        console.log(JSON.stringify(JSON.parse(parseGdbusString(output)), null, 2));
} catch (error) {
    console.error(String(error.stderr || error.message).trim());
    process.exit(1);
}
